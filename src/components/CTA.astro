---
import { Icon } from 'astro-iconify';
---

<section class="bg-linear-0 from-teal-800/50 to-teal-800/60 border border-teal-300/50 p-4 flex flex-col gap-2 rounded-lg text-slate-300 my-8" transition:name="cta">
  <h3 class="font-display text-2xl md:text-4xl text-white font-medium">Get started with Craig!</h3>
  <p class="text-sm md:text-base">Add Craig to your server and record anything in Discord voice channels and stage channels.</p>
  <div class="flex gap-2 flex-wrap mt-2 font-medium [&>a]:px-4 [&>a]:py-2 [&>a]:rounded-lg [&>a]:items-center [&>a]:transition-all [&>a]:active:scale-90">
    <a href="/invite" class="flex gap-2 bg-discord text-white hover:bg-discord/90">
      <Icon name="simple-icons:discord" class="size-6" />
      <span>Add to Discord</span>
    </a>
    <a href="https://docs.craig.chat" class="flex gap-2 bg-teal-500/25 hover:text-teal-50 text-teal-200 hover:bg-teal-500/50">
      <span>Read documentation</span>
    </a>
    <a href="https://discord.gg/craig" target="_blank" class="flex gap-2 bg-teal-500/25 hover:text-teal-50 text-teal-200 hover:bg-teal-500/50">
      <span>Join Support Server</span>
    </a>
  </div>
</section>